{
  "name": "opecode-model-autorouter",
  "version": "0.6.0",
  "description": "Route equivalent OpenCode models by live speed, cost and provider availability",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./rpc": "./rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "scripts": {
    "build": "npm run build:gui",
    "build:gui": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:memory": "node --expose-gc --test test/memory.test.ts",
    "test:sdk": "node test/sdk-compat.ts",
    "test:gui": "npm run build:gui && node --conditions=browser test/gui-bundle.ts",
    "test:live": "node test/live-router.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.14"
  }
}
