{
  "name": "opencode-project-folder-tabs",
  "version": "1.4.1",
  "description": "Display project folder names on OpenCode session tabs",
  "private": true,
  "type": "module",
  "exports": "./index.ts",
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:stress": "node --test test/stress.test.ts",
    "test:brutal": "node --test test/brutal.test.ts test/lifecycle.test.ts",
    "test:memory": "node --expose-gc --test test/memory.test.ts",
    "test:sdk": "node test/sdk-compat.ts",
    "test:live": "node test/live-integration.ts",
    "test:live:symbols": "node test/live-symbols.ts",
    "test:live:collisions": "node test/live-collisions.ts",
    "test:live:soak": "node test/live-soak.ts"
  }
}
